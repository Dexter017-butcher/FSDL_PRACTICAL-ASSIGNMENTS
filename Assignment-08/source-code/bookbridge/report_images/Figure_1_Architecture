		Context -> UI
	}
	subgraph cluster_backend {
		color=lightblue label="Node.js & Express
(Server)" style=filled
		API [label="Express Routes
(/api/auth, /api/books)" fillcolor=white shape=box style=filled]
		Mid [label="Middleware
(Multer, JWT Auth)" fillcolor=white shape=box style=filled]
		Models [label="Mongoose Models
(User, Book)" fillcolor=white shape=box style=filled]
