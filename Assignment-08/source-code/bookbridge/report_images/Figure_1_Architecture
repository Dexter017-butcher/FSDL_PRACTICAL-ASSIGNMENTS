digraph Architecture {
	dpi=300 rankdir=LR
	subgraph cluster_frontend {
		color=lightgrey label="React.js Frontend
(Client)" style=filled
		UI [label="React UI Components
(Home, Detail, Form)" fillcolor=white shape=box style=filled]
		Axios [label="API Interceptor
(Axios)" fillcolor=white shape=box style=filled]
		Context [label="Auth Context
(State & LocalStorage)" fillcolor=white shape=box style=filled]
